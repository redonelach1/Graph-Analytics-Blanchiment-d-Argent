# =============================================================================
# .gitignore — Mini-Projet 17
# =============================================================================

# Data directories (large files, datasets, Delta tables)
data/delta/
data/checkpoints/
data/graph_checkpoints/
data/datasets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Docker
docker/spark/*.jar

# Secrets / credentials
.env
*.key
*.pem

# Temporary
*.tmp
*.log
scratch/

# PyVis generated HTML
graph.html

# Node.js & Next.js
node_modules/
dashboard/node_modules/
.next/
dashboard/.next/
out/
dashboard/out/
.turbo/

# LaTeX intermediate build files (keep main.pdf)
*.aux
*.bbl
*.blg
*.lof
*.lol
*.lot
*.out
*.synctex.gz
*.toc
*.fls
*.fdb_latexmk



